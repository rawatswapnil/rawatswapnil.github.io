---
---

<section id="youtube" class="py-24 px-6">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-sm font-mono text-indigo-400 mb-2">Content</h2>
    <h3 class="text-3xl font-bold text-white mb-6">I create stuff online too</h3>
    <img
      src="/banner.png"
      alt="ezforcedotcom YouTube channel banner"
      class="w-full rounded-xl mb-8 border border-slate-800"
    />
    <p class="text-slate-400 leading-relaxed mb-10">
      I share content around Salesforce development, tech interviews, career growth,
      and real experiences from my journey. Whether you're just starting out or looking
      to level up, there's something for you.
    </p>

    <div class="grid sm:grid-cols-2 gap-6">
      <!-- YouTube -->
      <a
        href="https://www.youtube.com/@ezforcedotcom"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-6 rounded-xl border border-slate-800 bg-slate-900/50 hover:border-red-500/50 transition-colors"
      >
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <h4 class="text-white font-semibold text-lg">ezforcedotcom</h4>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          Video tutorials and vlogs on Salesforce development, career tips, and tech interviews.
        </p>
        <span class="inline-block mt-4 text-sm text-red-400 group-hover:text-red-300 transition-colors">
          Subscribe →
        </span>
      </a>

      <!-- Medium -->
      <a
        href="https://medium.com/@rawatswapnil911"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-6 rounded-xl border border-slate-800 bg-slate-900/50 hover:border-green-500/50 transition-colors"
      >
        <div class="flex items-center gap-3 mb-3">
          <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
          </svg>
          <h4 class="text-white font-semibold text-lg">Medium Blog</h4>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          Written articles and deep dives on Salesforce architecture, best practices, and lessons learned.
        </p>
        <span class="inline-block mt-4 text-sm text-green-400 group-hover:text-green-300 transition-colors">
          Read articles →
        </span>
      </a>
    </div>
  </div>
</section>
